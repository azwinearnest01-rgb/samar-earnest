# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL — used for canonical URLs, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Google Search Console "HTML tag" verification code (the content="..." value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Public correspondence address shown in the footer, contact page and privacy notice.
# Until set, a clearly marked placeholder is displayed.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Enquiry delivery (choose ONE) -------------------------------------------
# Without either option, the form tells visitors their enquiry was NOT sent.

# Option 1: POST each enquiry as JSON to a webhook (CRM, Zapier/Make, own API).
ENQUIRY_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>".
ENQUIRY_WEBHOOK_SECRET=

# Option 2: email each enquiry via Resend (https://resend.com).
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Must be an address on a domain verified with Resend.
ENQUIRY_FROM_EMAIL=
